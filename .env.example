# Copy to .env if you need to change defaults. Offline does not require keys.
LLM_MODE=offline
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
COMPACT_THRESHOLD_TOKENS=2000
COMPACT_KEEP_MESSAGES=6

# Leave these unset to inherit the main model; use another provider if needed.
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-2.5-flash
# JUDGE_TEMPERATURE=0
# JUDGE_API_KEY=
# JUDGE_BASE_URL=

# Credentials are required only when building a live cloud adapter.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://localhost:8000/v1
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # fallback when GEMINI_API_KEY is unset
# GEMINI_BASE_URL=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
